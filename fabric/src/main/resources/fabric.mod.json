    "issues": "https://github.com/Sylvan-Cheng/immersive-ui-sylvan/issues"
  },
  "icon": "icon.png",
  "license": "All Rights Reserved",
  "environment": "client",
  "entrypoints": {
    "client": [
      "it.hurts.shatterbyte.immersiveui.fabric.client.ImmersiveUIFabricClient"
